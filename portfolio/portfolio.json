    "ingest": "reads messy exports as they come",
    "normalise": "cleans values to one standard",
    "dedupe": "merges or flags duplicates",
    "classify": "puts each row in a named bucket",
    "score": "explainable points-based score",
    "route": "assigns an owner or next step",
    "review_queue": "sends risky rows to a human with a reason",
    "crm_output": "writes a CRM-ready import file, never writes to the CRM",
    "brief": "writes a plain-English brief",
    "sql": "uses SQL",
    "llm_optional": "runs on rules; Claude only if a key is set"
